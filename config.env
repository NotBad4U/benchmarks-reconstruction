CVC5_TIMEOUT=20               # seconds
CARCARA_CHECK_ELAB_TIMEOUT=20 # seconds
CARCARA_TRANSLATE_TIMEOUT=20  # seconds
LAMBDAPI_CHECK_TIMEOUT=30     # seconds
PROOF_SPLIT_LIMIT=1M          # fd size threshold (e.g. 1M, 500K)
MAX_RUN_HYPERFINE_SMALL=5     # perform at most N runs of lambdapi check on small benchs (10 by default)
MAX_RUN_HYPERFINE_LARGE=1     # perform at most N runs of lambdapi check on large benchs (1 by default)
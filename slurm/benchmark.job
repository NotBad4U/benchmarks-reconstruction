#!/bin/bash
#SBATCH --job-name=proof-bench
#SBATCH --output=proof-bench-%j.out
#SBATCH --error=proof-bench-%j.err
#SBATCH --time=2-00:00:00
#SBATCH --cpus-per-task=32
#SBATCH --mem=64G
#SBATCH --partition=cores
#SBATCH --mail-type=END,FAIL
#SBATCH --mail-user=alecol@itu.dk
#
# Run the proof-reconstruction pipeline and copy the results into $HOME.
#
#   sbatch slurm/benchmark.job              # QF_UF + UF (everything downloaded)
#   sbatch slurm/benchmark.job QF_UF        # one logic only
#   sbatch --export=ALL,SKIP_LARGE=1 slurm/benchmark.job   # small proofs only
#
# Requires slurm/setup.job to have run once.
#
# One partition, not `cores,cores_any` as the ITU docs suggest: this account's
# association has a partition set, and in that configuration SLURM rejects any
# request naming more than one --
#   "Multiple partition job request not supported when a partition is set in
#    the association"
# -- at submit time, before the job exists.  `cores` is the dedicated CPU
# partition.  `cores_any` (spare cores on the GPU nodes, 32+ each) is the
# alternative when `cores` is busy:
#
#   sbatch --partition=cores_any slurm/benchmark.job
#
# 32 cores / 64 GB: per sinfo every `cores` node has 40+ cores and 120 GB+, so
# 32 fits them all and also fits every `cores_any` node if you switch.  Memory
# is not the binding constraint.

set -euo pipefail

# See setup.job: the submitting shell's LC_CTYPE=UTF-8 does not exist on Rocky
# and every child process warns about it.  C is also a stable sort order.
export LC_ALL=C LANG=C

# ---------------------------------------------------------------------------
# Toolchain built by setup.job
# ---------------------------------------------------------------------------
PREFIX="$HOME/bench-toolchain"
if [ ! -f "$PREFIX/env.sh" ]; then
  echo "ERROR: $PREFIX/env.sh missing -- run 'sbatch slurm/setup.job' first." >&2
  exit 1
fi
# shellcheck disable=SC1091
source "$PREFIX/env.sh"

for b in cvc5 carcara lambdapi hyperfine; do
  command -v "$b" >/dev/null || { echo "ERROR: $b not on PATH" >&2; exit 1; }
done

# ---------------------------------------------------------------------------
# Which benchmarks
# ---------------------------------------------------------------------------
# No argument -> everything under $BENCHS_ROOT, which setup.job populated with
# QF_UF and UF.  An argument picks one subdirectory.
SUBSET="${1:-}"
BENCH_DIR="${BENCHS_ROOT}${SUBSET:+/$SUBSET}"
[ -d "$BENCH_DIR" ] || { echo "ERROR: no such benchmark dir: $BENCH_DIR" >&2; exit 1; }

# ---------------------------------------------------------------------------
# Work on node-local scratch, not in $HOME
# ---------------------------------------------------------------------------
# The pipeline writes one .proof, one .elab and one .lp per benchmark -- tens
# of thousands of small files.  $HOME is on a separate server with no
# infiniband link (per the ITU docs), so doing that there is painfully slow.
# Work locally, copy only the results back at the end.
for candidate in "/scratch/$USER" "${TMPDIR:-}" "/tmp/$USER"; do
  [ -n "$candidate" ] || continue
  if mkdir -p "$candidate" 2>/dev/null && [ -w "$candidate" ]; then
    SCRATCH_ROOT="$candidate"; break
  fi
done
: "${SCRATCH_ROOT:?no writable scratch directory found}"
JOB_DIR="$SCRATCH_ROOT/proof-bench-$SLURM_JOB_ID"
mkdir -p "$JOB_DIR"
# Deliberately no EXIT trap: if the pipeline dies, the scratch dir is the only
# evidence. It is removed at the end of a successful run instead.
trap 'echo "job failed -- scratch kept at $JOB_DIR" >&2' ERR

echo "=== node       : $(hostname)"
echo "=== cores      : ${SLURM_CPUS_PER_TASK:-1}"
echo "=== benchmarks : $BENCH_DIR ($(find "$BENCH_DIR" -name '*.smt2' | wc -l) files)"
echo "=== scratch    : $JOB_DIR"

# ---------------------------------------------------------------------------
# Python environment
# ---------------------------------------------------------------------------
module load Python/3.12.3-GCCcore-13.3.0
python -m venv "$JOB_DIR/venv"
# shellcheck disable=SC1091
source "$JOB_DIR/venv/bin/activate"
pip install --upgrade pip --quiet
pip install --no-cache-dir --quiet -r "$SLURM_SUBMIT_DIR/requirements.txt"

cd "$SLURM_SUBMIT_DIR"

# ---------------------------------------------------------------------------
# Run the pipeline
# ---------------------------------------------------------------------------
export BENCH_DIR JOB_DIR
# dsl-rewrite makes cvc5 emit rare_rewrite steps that carcara can only check
# with a RARE database (--rare-file), which we do not ship: with it, every
# elaboration fails.  theory-rewrite is the setting verified end to end.
export PROOF_GRANULARITY="${PROOF_GRANULARITY:-theory-rewrite}"

NPROC="${SLURM_CPUS_PER_TASK:-8}"

# Under sbatch stdout is a file, so Python block-buffers it and doit's task
# lines surface a few hundred at a time.  Job 169046 printed "=== pipeline ==="
# and then nothing for an hour while sstat showed six CPU-hours consumed.
export PYTHONUNBUFFERED=1

# And doit's lines carry no clock.  So, every PROGRESS_EVERY seconds, one line
# with a timestamp and the count of *finished* records per stage -- status/
# holds one JSON per (stage, stem), written when the task ends -- plus how many
# of them did not end in "success".  The stage order is the pipeline order, so
# the column that is still growing is the stage the run is in.
#
# `|| true` because grep -L can exit 1 even when it lists files.  Under pipefail
# that killed the job at the progress_line after doit, before results were copied.
TOTAL=$(find "$BENCH_DIR" -name '*.smt2' | wc -l | tr -d ' ')
progress_line() {
  line="=== $(date +%H:%M)"
  for stage in cvc5 elaborate translate_small translate_large \
               lambdapi_small_check lambdapi_large_check; do
    d="$JOB_DIR/status/$stage"
    [ -d "$d" ] || continue
    n=$(find "$d" -name '*.json' | wc -l | tr -d ' ')
    bad=$({ grep -rL '"status": "success"' --include='*.json' "$d" || true; } | wc -l | tr -d ' ')
    line="$line  $stage $n"
    if [ "$bad" -gt 0 ]; then line="$line (${bad} not success)"; fi
  done
  echo "$line"
}
progress_ticker() {
  while :; do sleep "${PROGRESS_EVERY:-300}"; progress_line; done
}

echo "=== pipeline === $(date +%H:%M)  $TOTAL benchmarks, progress every ${PROGRESS_EVERY:-300}s"
progress_ticker &
PROGRESS_PID=$!
# One invocation.  Stages 0-2 use every core.  The timed checks are
# serialised inside dodo.py (one_check_at_a_time), because a timing taken
# while other checks fight for the same cores measures the load, not
# lambdapi -- so -n does not distort the numbers that get reported.
doit -n "$NPROC" --parallel-type thread
kill "$PROGRESS_PID" 2>/dev/null || true
progress_line
echo "=== pipeline done === $(date +%H:%M)"

# ---------------------------------------------------------------------------
# Copy results into $HOME
# ---------------------------------------------------------------------------
# Only the light artifacts: status records, joblogs, hyperfine JSON, summary.
# proofs/, run/alethe/ and run/convert/ are the bulk and are reproducible.
OUT="$HOME/benchmark-results/$SLURM_JOB_ID"
mkdir -p "$OUT"

for d in status logs run/results; do
  if [ -d "$JOB_DIR/$d" ]; then
    mkdir -p "$OUT/$(dirname "$d")"
    cp -r "$JOB_DIR/$d" "$OUT/$(dirname "$d")/"
  fi
done
cp "$JOB_DIR/job_id.txt" "$OUT/" 2>/dev/null || true

# A machine-readable summary next to the raw records.
python collects.py "$JOB_DIR" --csv "$OUT/summary.csv" > "$OUT/summary.txt" 2>&1 || true

cat > "$OUT/run-info.txt" <<EOF
slurm_job_id    : $SLURM_JOB_ID
node            : $(hostname)
partition       : ${SLURM_JOB_PARTITION:-?}
cores           : ${SLURM_CPUS_PER_TASK:-?}
benchmark_dir   : $BENCH_DIR
proof_granularity: $PROOF_GRANULARITY
skip_large      : ${SKIP_LARGE:-0}
started         : $(date -Iseconds)
cvc5            : $(cvc5 --version | head -1)
carcara         : $(carcara --version)
lambdapi        : $(lambdapi --version 2>&1 | head -1)
hyperfine       : $(hyperfine --version)
EOF

tar -czf "$HOME/benchmark-results/$SLURM_JOB_ID.tar.gz" -C "$HOME/benchmark-results" "$SLURM_JOB_ID"

rm -rf "$JOB_DIR"

echo "=== done ==="
echo "results   : $OUT"
echo "tarball   : $HOME/benchmark-results/$SLURM_JOB_ID.tar.gz"
du -sh "$OUT"

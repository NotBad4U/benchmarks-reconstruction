#!/bin/bash
#SBATCH --job-name=bench-setup
#SBATCH --output=bench-setup-%j.out
#SBATCH --error=bench-setup-%j.err
#SBATCH --time=08:00:00
#SBATCH --cpus-per-task=16
#SBATCH --mem=32G
#SBATCH --partition=scavenge
#SBATCH --mail-type=END,FAIL
#SBATCH --mail-user=alecol@itu.dk
#
# One-off: build the toolchain into $HOME and download the benchmarks.
# Run this once; benchmark.job then just uses what this produced.
#
#   sbatch slurm/setup.job
#
# Built here rather than on the login node because ITU restricts accounts that
# run work there, and because the home directory has no infiniband link, so
# downloads and extraction are slow enough to want a compute node.
# scavenge is the right queue for this: low priority, and a build does not
# need a reserved high-performance node.

set -euo pipefail

# sbatch inherits the submitting shell's environment, and macOS ssh forwards
# LC_CTYPE=UTF-8, a locale Rocky does not have: without this every libtool
# invocation adds a setlocale warning to the log.
export LC_ALL=C LANG=C

PREFIX="$HOME/bench-toolchain"
BENCHS="$HOME/benchs"
# Everything transient goes to node-local disk.  $HOME is NFS with no infiniband
# link, and the only things that have to survive a job are the installed
# toolchain ($PREFIX/bin, the opam switch's lib/ and bin/) and the benchmarks.
# Unpacking and compiling there instead cost job 131053 one to three minutes per
# opam package at ~0% CPU.  /tmp on these nodes has tens of GB free; the whole
# toolchain is about 1 GB.
for candidate in "/scratch/$USER" "/tmp/$USER"; do
  if mkdir -p "$candidate" 2>/dev/null && [ -w "$candidate" ]; then
    LOCAL_SCRATCH="$candidate"; break
  fi
done
LOCAL_SCRATCH="${LOCAL_SCRATCH:-$HOME/tmp}"
export TMPDIR="$LOCAL_SCRATCH/tmp"
# cargo writes tens of thousands of object files; the binary it produces is
# installed into $PREFIX/bin, so the target tree need not persist.
export CARGO_TARGET_DIR="$LOCAL_SCRATCH/cargo-target"
mkdir -p "$TMPDIR" "$CARGO_TARGET_DIR"
echo "=== scratch: $LOCAL_SCRATCH ==="
mkdir -p "$PREFIX/bin" "$TMPDIR" "$BENCHS"

echo "=== node: $(hostname)  cores: ${SLURM_CPUS_PER_TASK:-1} ==="
JOBS="${SLURM_CPUS_PER_TASK:-4}"

# ---------------------------------------------------------------------------
# 0. Tools the compute nodes do not consistently have
# ---------------------------------------------------------------------------
# The nodes are not uniform.  cn14 has git and m4; cn8 has neither.  That cost
# two jobs: 130513 died for want of m4, and on cn8 job 131045's
# `git -C ... pull || true` silently did nothing while opam announced "you
# won't be able to use git repositories" -- which would have killed the
# lambdapi pin a quarter of an hour later, after the OCaml build.
#
# So resolve the tools up front and stop here if one cannot be had.
ensure_tool() {  # binary module-name... -- true if $binary ends up on PATH
  bin="$1"; shift
  command -v "$bin" >/dev/null 2>&1 && return 0
  for mod in "$@"; do
    if module load "$mod" >/dev/null 2>&1 && command -v "$bin" >/dev/null 2>&1; then
      echo "--- loaded module $mod for $bin ---"
      return 0
    fi
  done
  return 1
}

# git is needed three times: the carcara and lambdapi-stdlib clones, and the
# `opam pin` on lambdapi's master branch.
ensure_tool git git Git || {
  echo "ERROR: no git on $(hostname) and no git module would provide one" >&2
  exit 1
}
git --version

# ---------------------------------------------------------------------------
# 1. cvc5
# ---------------------------------------------------------------------------
# NOTE: cvc5 is NOT on conda-forge (the package does not exist), and there is
# no cvc5 module at ITU -- both checked, `module spider cvc5` finds nothing.  The
# upstream project publishes a static Linux binary, which needs no build and
# no shared libraries, so that is what we use.  Change CVC5_VERSION to pin.
CVC5_VERSION="${CVC5_VERSION:-1.4.0}"
if module spider cvc5 2>&1 | grep -qi "error\|not found"; then
  echo "--- no cvc5 module, installing the upstream static build ---"
fi
if [ ! -x "$PREFIX/bin/cvc5" ]; then
  cd "$TMPDIR"
  ZIP="cvc5-Linux-x86_64-static-gpl.zip"
  curl -fL --retry 3 -o "$ZIP" \
    "https://github.com/cvc5/cvc5/releases/download/cvc5-${CVC5_VERSION}/${ZIP}"
  rm -rf cvc5-unpack && mkdir cvc5-unpack && cd cvc5-unpack
  unzip -q "../$ZIP"
  find . -name cvc5 -type f -perm -u+x -exec cp {} "$PREFIX/bin/cvc5" \;
  chmod +x "$PREFIX/bin/cvc5"
  cd "$TMPDIR" && rm -rf cvc5-unpack "$ZIP"
fi
"$PREFIX/bin/cvc5" --version | head -1

# ---------------------------------------------------------------------------
# 2. Rust + carcara (NotBad4U/carcara, branch lambdapi-refactor)
# ---------------------------------------------------------------------------
# carcara's Cargo.toml declares edition 2024 / rust-version 1.93, which is
# newer than most site-provided Rust modules, so install a private toolchain.
export RUSTUP_HOME="$PREFIX/rustup" CARGO_HOME="$PREFIX/cargo"
if [ ! -x "$CARGO_HOME/bin/cargo" ]; then
  echo "--- installing rustup ---"
  curl -fsSL https://sh.rustup.rs | sh -s -- -y --no-modify-path --profile minimal
fi
export PATH="$CARGO_HOME/bin:$PATH"
rustup update stable
rustc --version

# A real checkout, not `cargo install --git`: that builds from a cache and
# keeps no source tree, and step 4 needs carcara's alethe-lp/ directory.
CARCARA_SRC="$PREFIX/src/carcara"
if [ ! -d "$CARCARA_SRC" ]; then
  mkdir -p "$PREFIX/src"
  git clone --branch lambdapi-refactor https://github.com/NotBad4U/carcara "$CARCARA_SRC"
fi
git -C "$CARCARA_SRC" pull --ff-only || echo "--- carcara pull skipped (not fast-forwardable) ---"

# carcara depends on rug -> gmp-mpfr-sys, which builds GMP from source, and
# GMP's configure aborts with "No usable m4 in $PATH" when m4 is missing -- it
# is missing on the ITU compute nodes, which is exactly where job 130513 died.
# Prefer a site module; otherwise build it here: a two-minute autotools build
# whose only dependency is the C compiler cargo is already using.
export PATH="$PREFIX/bin:$PATH"
if ! ensure_tool m4 M4 m4; then
  echo "--- no m4 on PATH and no m4 module, building it from source ---"
  M4_VERSION="${M4_VERSION:-1.4.19}"
  (
    cd "$TMPDIR"
    curl -fL --retry 3 -o "m4-$M4_VERSION.tar.gz" \
      "https://ftp.gnu.org/gnu/m4/m4-$M4_VERSION.tar.gz"
    rm -rf "m4-$M4_VERSION" && tar -xzf "m4-$M4_VERSION.tar.gz"
    cd "m4-$M4_VERSION"
    ./configure --prefix="$PREFIX"
    make -j"$JOBS" && make install
  )
  rm -rf "$TMPDIR/m4-$M4_VERSION" "$TMPDIR/m4-$M4_VERSION.tar.gz"
fi
m4 --version | head -1

if [ ! -x "$PREFIX/bin/carcara" ]; then
  echo "--- building carcara ---"
  cargo install --path "$CARCARA_SRC" --root "$PREFIX" --jobs "$JOBS" --force
fi
"$PREFIX/bin/carcara" --version

# hyperfine times stage 3 -- the one stage whose numbers get reported.  Not on
# the cluster, and cargo is already here, so build it alongside carcara.
if [ ! -x "$PREFIX/bin/hyperfine" ]; then
  echo "--- building hyperfine ---"
  cargo install hyperfine --locked --root "$PREFIX" --jobs "$JOBS"
fi
"$PREFIX/bin/hyperfine" --version

# ---------------------------------------------------------------------------
# 2b. C libraries opam needs and cannot install without root
# ---------------------------------------------------------------------------
# lambdapi master's opam file pulls in two heavyweights with C dependencies:
#   why3 >= 1.8  -> zarith   -> libgmp
#   dream        -> conf-libev -> libev
# Neither header is present on the ITU nodes.  The cluster does have `libevent`
# modules, but libevent is a different library and conf-libev will not accept
# it; there is no libev module at all.  So build both into $PREFIX.
#
# $PREFIX lives in $HOME, which every node mounts, so this also survives
# benchmark.job landing on a different node than this build -- a `module load`
# here would not, since the module would have to be loaded again there.
#
# The two exports below are what conf-libev's probe actually reads: its
# discover.ml walks C_INCLUDE_PATH and LIBRARY_PATH, strips the last path
# component of each entry and looks for <dir>/include/ev.h.  gcc honours the
# same two variables, which is what lets zarith's configure find gmp.h.
export C_INCLUDE_PATH="$PREFIX/include${C_INCLUDE_PATH:+:$C_INCLUDE_PATH}"
export LIBRARY_PATH="$PREFIX/lib${LIBRARY_PATH:+:$LIBRARY_PATH}"
export LD_LIBRARY_PATH="$PREFIX/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export PKG_CONFIG_PATH="$PREFIX/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"

have_header() {  # header -- true if cc can already find it
  printf '#include <%s>\nint main(void){return 0;}\n' "$1" > "$TMPDIR/probe.c"
  cc -c "$TMPDIR/probe.c" -o "$TMPDIR/probe.o" 2>/dev/null
  rc=$?
  rm -f "$TMPDIR/probe.c" "$TMPDIR/probe.o"
  return $rc
}

install_c_lib() {  # label url configure-args...
  label="$1"; url="$2"; shift 2
  tarball="${url##*/}"
  build="$TMPDIR/build-${tarball%%.tar*}"
  echo "--- building $label into $PREFIX ---"
  (
    cd "$TMPDIR"
    curl -fL --retry 3 -sS -o "$tarball" "$url"
    # Do NOT learn the top-level directory with `tar -tf "$tarball" | head -1`:
    # GNU tar's decompression child dies when head closes the pipe, and under
    # `set -o pipefail` that kills the whole job without printing anything.
    # Job 130526 died exactly there, right after the download.  Extract into a
    # private directory and use its single child instead.
    rm -rf "$build" && mkdir -p "$build"
    tar -xf "$tarball" -C "$build"
    cd "$build"/*/
    ./configure --prefix="$PREFIX" "$@"
    make -j"$JOBS"
    make install
  )
  rm -rf "$build" "$TMPDIR/$tarball"
}

# --with-pic on both: OCaml links these into C stubs, and a non-PIC static
# archive fails to link into a shared stub with "recompile with -fPIC".
if have_header gmp.h; then
  echo "--- gmp.h already available, not building GMP ---"
else
  install_c_lib "GMP ${GMP_VERSION:=6.3.0}" \
    "https://ftp.gnu.org/gnu/gmp/gmp-$GMP_VERSION.tar.xz" \
    --with-pic --enable-shared --enable-static
fi

if have_header ev.h; then
  echo "--- ev.h already available, not building libev ---"
else
  install_c_lib "libev ${LIBEV_VERSION:=4.33}" \
    "http://dist.schmorp.de/libev/libev-$LIBEV_VERSION.tar.gz" \
    --with-pic
fi

# ---------------------------------------------------------------------------
# 3. opam + OCaml + lambdapi (deducteam/lambdapi, master)
# ---------------------------------------------------------------------------
# opam is not installed on the cluster, so fetch the single static opam binary
# and build a private switch.  --disable-sandboxing is REQUIRED: opam's
# sandbox uses bubblewrap/user namespaces, which are restricted on most HPC
# nodes, and without this flag every package build fails.
export OPAMROOT="$PREFIX/opam"
# opam carries no `jobs` setting, so package builds run near-serially: job
# 131045 averaged 0.29 of a core over 20 minutes on a 16-CPU allocation, most
# of the OCaml compiler build being one `make` at a time.  OPAMJOBS is what
# feeds the %{jobs}% that opam package build commands expand, so pin it to the
# allocation -- not to the node, which has 256 cores we were not given.
export OPAMJOBS="$JOBS"
OCAML_VERSION="${OCAML_VERSION:-5.2.0}"
OPAM_VERSION="${OPAM_VERSION:-2.6.0}"
# Not shell/install.sh.  It accepts no positional install directory -- passing
# one prints its usage and exits 2, which is how job 131044 died -- and it then
# *prompts* for the directory, reading the answer with `read` from stdin, which
# when piped is the script's own text.  There is no non-interactive form.  The
# release ships a static x86_64 binary, so fetch it exactly like cvc5.
if [ ! -x "$PREFIX/bin/opam" ]; then
  echo "--- installing opam $OPAM_VERSION ---"
  curl -fL --retry 3 -sS -o "$PREFIX/bin/opam" \
    "https://github.com/ocaml/opam/releases/download/$OPAM_VERSION/opam-$OPAM_VERSION-x86_64-linux"
  chmod +x "$PREFIX/bin/opam"
fi
export PATH="$PREFIX/bin:$PATH"
opam --version

if [ ! -d "$OPAMROOT" ]; then
  opam init --bare --disable-sandboxing --no-setup --yes
fi
# opam fetches three packages at a time by default, and lambdapi's closure --
# dream and why3 between them -- is around two hundred of them.  Job 131053 sat
# at 5% of one core for twelve minutes, entirely waiting on the network, roughly
# 30 seconds per package.  Raise it: this is latency, not bandwidth.
opam option download-jobs=16 --global >/dev/null
# A switch that exists is not necessarily a switch that works: scavenge is
# preemptible, so a job killed mid-build leaves the name registered with no
# usable compiler behind it, and the old `switch list` guard would then skip
# the build and fail somewhere far less obvious.  Ask ocamlc instead.
if ! opam exec --switch="$OCAML_VERSION" -- ocamlc -version >/dev/null 2>&1; then
  if opam switch list --short | grep -qx "$OCAML_VERSION"; then
    echo "--- switch $OCAML_VERSION has no working ocamlc, recreating ---"
    opam switch remove "$OCAML_VERSION" --yes || true
  fi
  echo "--- building OCaml $OCAML_VERSION with $JOBS jobs ---"
  opam switch create "$OCAML_VERSION" --yes
fi
eval "$(opam env --switch="$OCAML_VERSION" --set-switch)"
ocaml -version

# ---------------------------------------------------------------------------
# opam's transient trees belong on node-local disk
# ---------------------------------------------------------------------------
# opam copies every package's whole source tree into
# $OPAMROOT/<switch>/.opam-switch/sources/ and builds under .../build/.  For
# lambdapi's closure -- around two hundred packages once dream and why3 are
# resolved -- that is thousands of small files per package written to $HOME,
# which is NFS with no infiniband link.  Measured on job 131053: one to three
# minutes per package at ~0% CPU, pure metadata latency, which does not fit in
# the job's time limit.  Both trees are throwaway; only lib/ and bin/ have to
# persist.  Re-point them every run, because the node changes and yesterday's
# symlink is today's dangling one.
SWITCH_DIR="$OPAMROOT/$OCAML_VERSION/.opam-switch"
OPAM_SCRATCH="$LOCAL_SCRATCH/opam-build"
if [ -d "$SWITCH_DIR" ]; then
  for d in sources build; do
    mkdir -p "$OPAM_SCRATCH/$d"
    [ -L "$SWITCH_DIR/$d" ] || rm -rf "$SWITCH_DIR/$d"
    ln -sfn "$OPAM_SCRATCH/$d" "$SWITCH_DIR/$d"
  done
  echo "--- opam sources/ and build/ -> $OPAM_SCRATCH ---"
fi

echo "--- building lambdapi from master ---"
opam pin add lambdapi https://github.com/deducteam/lambdapi.git#master --yes
lambdapi --version || true

# ---------------------------------------------------------------------------
# 4. The Lambdapi libraries the translated proofs `require`, in order:
#      Stdlib  <- NotBad4U/lambdapi-stdlib
#      alethe  <- carcara's own alethe-lp/   (alethe.core, alethe.prop, ...)
# ---------------------------------------------------------------------------
# alethe-lp requires Stdlib.HOL, Stdlib.Z, Stdlib.List, ... so Stdlib must be
# installed first: `make install` compiles every module before installing.
# Both land in the lib_root of the opam switch loaded above; lambdapi only
# finds that root because OPAM_SWITCH_PREFIX is set (by `opam env`).  Without
# it lambdapi falls back to /usr/local/lib/lambdapi/lib_root and finds nothing.
if [ ! -d "$PREFIX/src/lambdapi-stdlib" ]; then
  mkdir -p "$PREFIX/src"
  git clone https://github.com/NotBad4U/lambdapi-stdlib "$PREFIX/src/lambdapi-stdlib"
fi
git -C "$PREFIX/src/lambdapi-stdlib" pull --ff-only || true
make -C "$PREFIX/src/lambdapi-stdlib" install

make -C "$CARCARA_SRC/alethe-lp" install

# Prove it: every translated proof starts with `require open alethe.core`.
# Failing here costs nothing; finding out from thousands of failed checks in
# a two-day benchmark run does.
PROBE="$(mktemp -d)"
printf 'package_name = probe\nroot_path = probe\n' > "$PROBE/lambdapi.pkg"
printf 'require open alethe.core;\nrequire open alethe.prop;\n' > "$PROBE/probe.lp"
if ! (cd "$PROBE" && lambdapi check -w -v 0 probe.lp); then
  echo "ERROR: lambdapi cannot resolve alethe.core -- check OPAM_SWITCH_PREFIX" >&2
  exit 1
fi
rm -rf "$PROBE"
echo "--- alethe.core resolves ---"

# ---------------------------------------------------------------------------
# 5. Benchmarks (QF_UF and UF by default)
# ---------------------------------------------------------------------------
cd "$SLURM_SUBMIT_DIR"
BENCHS_DIR="$BENCHS" bash download_benchs.sh
du -sh "$BENCHS"/* 2>/dev/null || true

# ---------------------------------------------------------------------------
# 6. Write the environment file benchmark.job sources
# ---------------------------------------------------------------------------
cat > "$PREFIX/env.sh" <<EOF
# generated by slurm/setup.job on $(date -Iseconds)
export PREFIX="$PREFIX"
export RUSTUP_HOME="$PREFIX/rustup"
export CARGO_HOME="$PREFIX/cargo"
export OPAMROOT="$PREFIX/opam"
export PATH="$PREFIX/bin:$PREFIX/cargo/bin:\$PATH"
eval "\$(opam env --switch=$OCAML_VERSION --set-switch 2>/dev/null)" || true
export C_INCLUDE_PATH="$PREFIX/include\${C_INCLUDE_PATH:+:\$C_INCLUDE_PATH}"
export LIBRARY_PATH="$PREFIX/lib\${LIBRARY_PATH:+:\$LIBRARY_PATH}"
export LD_LIBRARY_PATH="$PREFIX/lib\${LD_LIBRARY_PATH:+:\$LD_LIBRARY_PATH}"
export PKG_CONFIG_PATH="$PREFIX/lib/pkgconfig\${PKG_CONFIG_PATH:+:\$PKG_CONFIG_PATH}"
export BENCHS_ROOT="$BENCHS"
EOF

echo "=== setup complete ==="
echo "toolchain : $PREFIX"
echo "benchmarks: $BENCHS"
for b in cvc5 carcara lambdapi hyperfine; do
  printf "  %-10s %s\n" "$b" "$(command -v $b || echo MISSING)"
done
